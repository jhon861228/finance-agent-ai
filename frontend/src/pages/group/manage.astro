---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import "../../styles/components.css";
import {
    getUserGroups,
    createGroup,
    addMember,
    getUserByUsername,
    type Group,
} from "../../lib/db";

const username = Astro.cookies.get("username")?.value;
const token = Astro.cookies.get("token")?.value;

if (!username || !token) {
    return Astro.redirect("/");
}

const me = await getUserByUsername(username, token);
if (!me) return Astro.redirect("/");

let error = "";
let success = "";

if (Astro.request.method === "POST") {
    const data = await Astro.request.formData();
    const action = data.get("action");

    try {
        if (action === "create-group") {
            const name = data.get("name")?.toString();
            if (name) {
                await createGroup(
                    name,
                    me.userId,
                    username,
                    me.telegramId || "",
                    token,
                );
                success = `Group "${name}" created!`;
            }
        } else if (action === "add-member") {
            const groupId = data.get("groupId")?.toString();
            const memberUser = data.get("memberUsername")?.toString();

            if (groupId && memberUser) {
                const targetUser = await getUserByUsername(memberUser, token);
                if (targetUser) {
                    await addMember(
                        groupId,
                        memberUser,
                        targetUser.userId,
                        token,
                    );
                    success = `¡${memberUser} añadido al grupo!`;
                } else {
                    // If user not found in DB, we can still try to add them by name (legacy support)
                    await addMember(groupId, memberUser, undefined, token);
                    success = `¡${memberUser} añadido al grupo (como nuevo perfil)!`;
                }
            }
        }
    } catch (e: any) {
        error = e.message || "Operación fallida.";
    }
}

const groups: Group[] = await getUserGroups(me.userId, token);
---

<Layout title="Administrar Grupos">
    <div class="manage-groups-container">
        <PageHeader username={me.name} title="Grupos" showBack={true} />

        {error && <div class="error-msg">{error}</div>}
        {success && <div class="success-msg">{success}</div>}

        <section class="manage-section">
            <div class="sec-header">
                <h2>CREAR NUEVO GRUPO</h2>
            </div>
            <div class="glass-panel create-box">
                <p class="muted">
                    Inicia un nuevo fondo compartido para gastos en común.
                </p>
                <form method="POST" class="create-form">
                    <input type="hidden" name="action" value="create-group" />
                    <div class="input-group-luxury">
                        <label for="name">NOMBRE DEL GRUPO</label>
                        <input
                            type="text"
                            name="name"
                            id="name"
                            placeholder="Ej. Viaje a Japón, Alquiler..."
                            required
                        />
                    </div>
                    <button type="submit" class="glow-btn">
                        CREAR GRUPO
                    </button>
                </form>
            </div>
        </section>

        <section class="groups-list-section">
            <h2 class="sec-title">TUS GRUPOS</h2>
            <div class="groups-grid">
                {
                    groups.map((group) => (
                        <div class="glass-panel group-manage-card">
                            <div class="group-info">
                                <h4>{group.name}</h4>
                                <p class="muted">
                                    {group.members.length} miembros
                                </p>
                            </div>

                            <div class="add-member-zone">
                                <form method="POST" class="add-member-form">
                                    <input
                                        type="hidden"
                                        name="action"
                                        value="add-member"
                                    />
                                    <input
                                        type="hidden"
                                        name="groupId"
                                        value={group.groupId}
                                    />
                                    <input
                                        type="text"
                                        name="memberUsername"
                                        placeholder="Nombre de Usuario"
                                        required
                                    />
                                    <button
                                        type="submit"
                                        class="glow-btn small"
                                    >
                                        Añadir
                                    </button>
                                </form>
                            </div>

                            <div class="members-list">
                                {group.members.map((m) => (
                                    <span class="member-tag">{m.name}</span>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </section>
    </div>
</Layout>

<style>
    .manage-groups-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .sec-title {
        font-size: 0.9rem;
        margin-bottom: 1rem;
        color: var(--text-muted);
    }

    .create-box {
        padding: 1.5rem;
    }

    .create-box .muted {
        margin: 0 0 1.2rem 0;
        font-size: 0.85rem;
    }

    .create-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .input-group-luxury {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .input-group-luxury label {
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        text-transform: uppercase;
    }

    .input-group-luxury input {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--glass-border);
        padding: 12px 16px;
        border-radius: 12px;
        color: var(--text);
        font-size: 0.95rem;
        width: 100%;
        box-sizing: border-box;
        transition: border-color 0.2s;
    }

    .input-group-luxury input:focus {
        outline: none;
        border-color: var(--primary);
    }

    .glow-btn {
        width: 100%;
    }

    .groups-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .group-manage-card {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .group-info h4 {
        margin: 0;
        font-size: 1.2rem;
        color: var(--primary);
    }

    .add-member-form {
        display: flex;
        gap: 0.5rem;
    }

    .add-member-form input {
        flex: 1;
        background: rgba(0, 0, 0, 0.1);
        border: 1px solid var(--glass-border);
        padding: 8px 12px;
        border-radius: 8px;
        color: var(--text);
        font-size: 0.9rem;
    }

    .glow-btn.small {
        padding: 8px 16px;
        font-size: 0.8rem;
    }

    .members-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .member-tag {
        background: var(--secondary);
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-muted);
    }

    .error-msg {
        color: #ff4d4d;
        background: rgba(255, 77, 77, 0.1);
        padding: 10px;
        border-radius: 8px;
        border: 1px solid rgba(255, 77, 77, 0.3);
    }

    .success-msg {
        color: #4caf50;
        background: rgba(76, 175, 80, 0.1);
        padding: 10px;
        border-radius: 8px;
        border: 1px solid rgba(76, 175, 80, 0.3);
    }

    :global([data-theme="light"]) .horizontal-form input,
    :global([data-theme="light"]) .add-member-form input {
        background: #fff;
        border-color: #cbd5e1;
        color: #1a1a1a;
    }
</style>
