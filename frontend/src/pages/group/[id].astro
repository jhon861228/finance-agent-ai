---
const username = Astro.cookies.get("username")?.value;
const token = Astro.cookies.get("token")?.value;

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ExpenseItem from "../../components/ExpenseItem.astro";
import "../../styles/components.css";

import {
    getGroupDetails,
    getUserByUsername,
    addMember,
    type Expense,
    type User,
} from "../../lib/db";
import { simplifyDebts } from "../../lib/debt";
import { formatAmount } from "../../lib/format";

const { id } = Astro.params;

if (!id || !username || !token) {
    if (!token) Astro.cookies.delete("username");
    return Astro.redirect("/");
}

const group = await getGroupDetails(id, token);
const currentUser = await getUserByUsername(username, token);

if (!group || !currentUser) {
    Astro.cookies.delete("token");
    Astro.cookies.delete("username");
    return Astro.redirect("/");
}

let error = "";
let success = "";

if (Astro.request.method === "POST") {
    const data = await Astro.request.formData();
    const action = data.get("action");

    if (action === "add-member") {
        const targetUsername = data.get("targetUsername")?.toString();
        if (targetUsername) {
            try {
                const targetUser = await getUserByUsername(
                    targetUsername,
                    token,
                );
                if (targetUser) {
                    await addMember(
                        id,
                        targetUsername,
                        targetUser.userId,
                        token,
                    );
                    success = `¡Se ha añadido a ${targetUsername} con éxito!`;
                    // Refresh group data
                    return Astro.redirect(`/group/${id}?success=MemberAdded`);
                } else {
                    error = `Usuario @${targetUsername} no encontrado.`;
                }
            } catch (e: any) {
                error = e.message || "Error al añadir miembro.";
            }
        }
    }
}

const flashSuccess = Astro.url.searchParams.get("success") === "MemberAdded";
if (flashSuccess && !success) success = "¡Miembro añadido con éxito!";

// Use projected stats
const totalSpent =
    typeof group.totalSpent === "number"
        ? group.totalSpent
        : (group.balances || []).reduce((s, b) => s + (b.paidAmount || 0), 0);
const memberCount = group.memberCount || group.members.length || 1;
const perPersonShare = memberCount > 0 ? totalSpent / memberCount : 0;

const memberBalances: Record<string, number> = {};
group.balances.forEach((b) => {
    memberBalances[b.userId] = b.netBalance || 0;
});

const transactions = group.settlements || [];

// Map User IDs to Names for display
const idToName: Record<string, string> = {};
group.members.forEach((m) => {
    idToName[m.userId] = m.name;
});

// Calcular gastos por miembro
const memberSpent: Record<string, number> = {};
group.members.forEach((m) => {
    memberSpent[m.userId] = 0;
});
group.expenses.forEach((exp) => {
    if (exp.payerId && memberSpent[exp.payerId] !== undefined) {
        memberSpent[exp.payerId] += exp.amount;
    }
});
---

<Layout title={`Group: ${group.name}`}>
    <div class="premium-group-detail">
        <PageHeader
            username={username}
            title={group.name}
            showBack={true}
            backUrl="/dashboard"
        />

        {error && <div class="error-msg">{error}</div>}
        {success && <div class="success-msg">{success}</div>}

        <!-- Stats Grid -->
        <section class="group-stats-luxury">
            <div class="stat-luxury-card">
                <span class="stat-l-label">TOTAL GASTADO</span>
                <span class="stat-l-val gold-text"
                    >${totalSpent.toFixed(2)}</span
                >
            </div>
            <div class="stat-luxury-card">
                <span class="stat-l-label">TU CUOTA</span>
                <span class="stat-l-val">${perPersonShare.toFixed(2)}</span>
            </div>
            <div class="stat-luxury-card">
                <span class="stat-l-label">MIEMBROS</span>
                <span class="stat-l-val">{group.members.length}</span>
            </div>
        </section>

        <!-- Settlements (Liquidations) -->
        <section class="settlements-luxury">
            <div class="sec-header">
                <h2>LIQUIDACIONES</h2>
                <span class="status-pill settled"
                    >{transactions.length === 0 ? "SALDADO" : "PENDIENTE"}</span
                >
            </div>
            <div class="settlement-cards">
                {
                    transactions.length === 0 ? (
                        <div class="premium-card empty-settlement">
                            <span class="empty-icon">🥂</span>
                            <p>
                                Todas las cuentas están perfectamente saldadas.
                            </p>
                        </div>
                    ) : (
                        transactions.map((t) => (
                            <div class="premium-card settlement-card-alt">
                                <div class="settle-flow">
                                    <span class="s-name">
                                        {idToName[t.from] || t.from}
                                    </span>
                                    <span class="s-arrow gold-text">→</span>
                                    <span class="s-name">
                                        {idToName[t.to] || t.to}
                                    </span>
                                </div>
                                <div class="settle-amount gold-text">
                                    ${t.amount.toFixed(2)}
                                </div>
                            </div>
                        ))
                    )
                }
            </div>
            <button
                id="settle-btn"
                class="mini-glow-btn"
                style="margin-left:1rem;">Saldar cuentas</button
            >
        </section>

        <!-- Expense History -->
        <section class="group-expenses-luxury">
            <div class="sec-header">
                <h2>HISTORIAL DE TRANSACCIONES</h2>
            </div>
            <div class="luxury-expense-list">
                {
                    group.expenses.length === 0 ? (
                        <p class="muted">
                            No hay transacciones registradas aún.
                        </p>
                    ) : (
                        group.expenses
                            .slice()
                            .reverse()
                            .map((exp) => (
                                <ExpenseItem
                                    description={exp.description}
                                    amount={exp.amount}
                                    category={exp.category}
                                    source="Group"
                                    timestamp={exp.timestamp}
                                    payerName={
                                        idToName[exp.payerId || ""] || "Unknown"
                                    }
                                    isNegative={true}
                                />
                            ))
                    )
                }
            </div>
        </section>

        <!-- Member Balances -->
        <section class="member-balances-luxury">
            <div class="sec-header">
                <h2>ESTADO DE MIEMBROS</h2>
                <div class="add-member-trigger">
                    <form method="POST" class="inline-add-member">
                        <input type="hidden" name="action" value="add-member" />
                        <input
                            type="text"
                            name="targetUsername"
                            placeholder="Añadir por @usuario"
                            required
                            autocomplete="off"
                        />
                        <button type="submit" class="mini-glow-btn">+</button>
                    </form>
                </div>
            </div>
            <div class="balances-grid">
                {
                    group.members.map((m) => {
                        const bal = memberBalances[m.userId] || 0;
                        const spent = memberSpent[m.userId] || 0;
                        return (
                            <div class="bal-item">
                                <div class="bal-user">
                                    <div class="avatar-xs">
                                        {m.name[0].toUpperCase()}
                                    </div>
                                    <span>{m.name}</span>
                                </div>
                                <span
                                    class="bal-val"
                                    style="color:#bfa14a;margin-left:1rem;"
                                >
                                    Gastó: ${formatAmount(spent)}
                                </span>
                            </div>
                        );
                    })
                }
            </div>
            <div id="settle-result" style="margin-top:1.5rem;"></div>
        </section>

        <script>
            // Mostrar liquidaciones al pulsar el botón
            if (typeof window !== "undefined") {
                document.addEventListener("DOMContentLoaded", () => {
                    const btn = document.getElementById("settle-btn");
                    const result = document.getElementById("settle-result");
                    if (btn && result) {
                        btn.onclick = () => {
                            // Mostrar las liquidaciones
                            const txs = JSON.parse(
                                "{JSON.stringify(transactions)}",
                            );
                            const idToName = JSON.parse(
                                "{JSON.stringify(idToName)}",
                            );
                            let html = "<h3>Liquidaciones:</h3>";
                            if (txs.length === 0) {
                                html += "<p>Todo está saldado.</p>";
                            } else {
                                html += "<ul style='margin-left:1rem;'>";
                                txs.forEach((t: any) => {
                                    html += `<li><b>${idToName[t.from] || t.from}</b> paga <b>$${t.amount.toFixed(2)}</b> a <b>${idToName[t.to] || t.to}</b></li>`;
                                });
                                html += "</ul>";
                            }
                            result.innerHTML = html;
                        };
                    }
                });
            }
        </script>
    </div>
</Layout>

<style>
    .premium-group-detail {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    /* Stats Grid */
    .group-stats-luxury {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

    .stat-luxury-card {
        background: var(--card-bg);
        border-radius: 20px;
        padding: 1.2rem 1rem;
        border: 1px solid var(--glass-border);
        display: flex;
        flex-direction: column;
        gap: 4px;
        align-items: center;
    }

    .stat-l-label {
        font-size: 0.55rem;
        font-weight: 800;
        color: var(--text-muted);
        letter-spacing: 0.05em;
    }

    .stat-l-val {
        font-family: "Montserrat", sans-serif;
        font-weight: 700;
        font-size: 1rem;
    }

    .settlement-cards {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .empty-settlement {
        text-align: center;
        padding: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: center;
        color: var(--text-muted);
    }

    .empty-icon {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .settlement-card-alt {
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .settle-flow {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .s-name {
        font-weight: 700;
        font-size: 0.95rem;
    }

    .s-arrow {
        font-size: 1.2rem;
        font-weight: 400;
    }

    .settle-amount {
        font-size: 1.1rem;
        font-weight: 800;
        font-family: "Montserrat", sans-serif;
    }

    /* Expenses */
    .luxury-expense-list {
        display: flex;
        flex-direction: column;
    }

    /* Balances */
    .balances-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        background: var(--card-bg);
        border-radius: 24px;
        padding: 1.5rem;
        border: 1px solid var(--glass-border);
    }

    .bal-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .bal-user {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .bal-user span {
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .bal-val {
        font-weight: 700;
        font-size: 0.85rem;
    }

    .bal-val.positive {
        color: #2ecc71;
    }

    .bal-val.negative {
        color: #e74c3c;
    }

    /* Add Member UI */
    .inline-add-member {
        display: flex;
        gap: 0.5rem;
        background: var(--card-bg);
        padding: 4px;
        border-radius: 12px;
        border: 1px solid var(--glass-border);
    }

    .inline-add-member input {
        background: transparent;
        border: none;
        padding: 4px 8px;
        color: var(--text);
        font-size: 0.8rem;
        width: 120px;
        outline: none;
    }

    .mini-glow-btn {
        background: var(--gold-gradient);
        border: none;
        border-radius: 8px;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #000;
        font-weight: 800;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .mini-glow-btn:hover {
        transform: scale(1.1);
    }

    .error-msg {
        background: rgba(231, 76, 60, 0.1);
        color: #e74c3c;
        padding: 1rem;
        border-radius: 12px;
        border: 1px solid rgba(231, 76, 60, 0.2);
        margin-bottom: 1rem;
    }

    .success-msg {
        background: rgba(46, 204, 113, 0.1);
        color: #2ecc71;
        padding: 1rem;
        border-radius: 12px;
        border: 1px solid rgba(46, 204, 113, 0.2);
        margin-bottom: 1rem;
    }
</style>
