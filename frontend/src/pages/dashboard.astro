---
const username = Astro.cookies.get("username")?.value;
const token = Astro.cookies.get("token")?.value;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import PortfolioSummary from "../components/PortfolioSummary.astro";
import GroupCard from "../components/GroupCard.astro";
import ExpenseItem from "../components/ExpenseItem.astro";
import TelegramLink from "../components/TelegramLink.astro";
import "../styles/components.css";

import {
	getUserByUsername,
	getPersonalExpenses,
	getUserGroups,
	generateLinkingCode,
	type Expense,
	type Group,
} from "../lib/db";

if (!username || !token) {
	return Astro.redirect("/");
}

const user = await getUserByUsername(username, token);

if (!user) {
	Astro.cookies.delete("token");
	Astro.cookies.delete("username");
	return Astro.redirect("/?error=UserNotFound");
}

const personalExpenses: Expense[] = await getPersonalExpenses(
	user.userId,
	token,
);
const groups: Group[] = await getUserGroups(user.userId, token);

const totalPersonalSpend = user.totalSpent || 0;

// Calculate total wealth: personal spent + user contributions to all groups
const totalGroupContributions = groups.reduce((sum, g) => {
	return (
		sum +
		g.expenses
			.filter((e) => e.payerId === user.userId)
			.reduce((s, e) => s + e.amount, 0)
	);
}, 0);

const totalWealth = totalPersonalSpend + totalGroupContributions;

let linkCode = null;
if (Astro.request.method === "POST") {
	const data = await Astro.request.formData();
	if (data.get("action") === "generate-code") {
		linkCode = await generateLinkingCode(user.userId, token);
	}
}

// Unify expenses with source information
const allExpenses = [
	...personalExpenses.map((e) => ({
		...e,
		source: "Personal",
		sourceType: "personal" as const,
	})),
	...groups.flatMap((g) =>
		g.expenses
			.filter((e) => e.payerId === user.userId)
			.map((e) => ({
				...e,
				source: g.name,
				sourceType: "group" as const,
			})),
	),
].sort((a, b) => b.timestamp - a.timestamp);

// Calculate Month Comparison
const now = new Date();
const curMonth = now.getMonth();
const curYear = now.getFullYear();

const prevDate = new Date(curYear, curMonth - 1, 1);
const pMonth = prevDate.getMonth();
const pYear = prevDate.getFullYear();

const curMonthTotal = allExpenses
	.filter((e) => {
		const d = new Date(e.timestamp);
		return d.getMonth() === curMonth && d.getFullYear() === curYear;
	})
	.reduce((sum, e) => sum + e.amount, 0);

const prevMonthTotal = allExpenses
	.filter((e) => {
		const d = new Date(e.timestamp);
		return d.getMonth() === pMonth && d.getFullYear() === pYear;
	})
	.reduce((sum, e) => sum + e.amount, 0);

let trend;
if (prevMonthTotal > 0) {
	const diff = ((curMonthTotal - prevMonthTotal) / prevMonthTotal) * 100;
	const sign = diff >= 0 ? "+" : "";
	trend = `${sign}${diff.toFixed(1)}% vs last month`;
} else if (allExpenses.length > 0 && curMonthTotal > 0) {
	trend = "Primer mes de actividad";
}
---

<Layout title="Dashboard">
	<div class="premium-dashboard">
		<PageHeader username={user.name} />

		<div class="wealth-toggle-container">
			<div class="luxury-toggle" id="expense-toggle">
				<button class="toggle-opt active" data-type="personal"
					>Personales</button
				>
				<button class="toggle-opt" data-type="total">Totales</button>
				<div class="toggle-slider"></div>
			</div>
		</div>

		<div id="summary-personal">
			<PortfolioSummary
				amount={totalPersonalSpend}
				label="MIS GASTOS"
				trend={trend}
			/>
		</div>
		<div id="summary-total" style="display: none;">
			<PortfolioSummary
				amount={totalWealth}
				label="MIS GASTOS"
				trend={trend}
			/>
		</div>

		<!-- Telegram Link Section -->
		<TelegramLink
			telegramId={user.telegramId || null}
			linkCode={linkCode || null}
		/>

		<!-- Group Cards -->
		<section class="cards-section">
			<div class="sec-header">
				<h2>TUS GRUPOS</h2>
				<a href="/group/manage" class="manage-btn">GESTIONAR</a>
			</div>
			<div class="cards-scroll">
				{
					groups.map((group, index) => (
						<GroupCard
							group={group}
							username={username}
							index={index}
						/>
					))
				}
				{
					groups.length === 0 && (
						<p class="muted">Aún no tienes grupos.</p>
					)
				}
			</div>
		</section>

		<!-- Recent Transactions -->
		<section class="transactions-section">
			<div class="sec-header">
				<h2>ÚLTIMAS TRANSACCIONES</h2>
			</div>
			<div class="glass-panel transactions-list">
				{
					allExpenses
						.slice(0, 20)
						.map((e) => (
							<ExpenseItem
								description={e.description}
								amount={e.amount}
								category={e.category}
								source={e.source}
								timestamp={e.timestamp}
								isNegative={true}
							/>
						))
				}
				{
					allExpenses.length === 0 && (
						<p class="muted" style="padding: 1rem 0;">
							Aún no hay transacciones registradas.
						</p>
					)
				}
			</div>
		</section>
	</div>
</Layout>

<style>
	.premium-dashboard {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	/* Wealth Toggle */
	.wealth-toggle-container {
		display: flex;
		justify-content: center;
		margin-bottom: 1rem;
	}

	.luxury-toggle {
		background: var(--nav-bg);
		padding: 4px;
		border-radius: 12px;
		display: flex;
		position: relative;
		border: 1px solid var(--glass-border);
		width: 200px;
	}

	.toggle-opt {
		flex: 1;
		background: transparent;
		border: none;
		color: var(--text-muted);
		font-size: 0.7rem;
		font-weight: 700;
		padding: 8px 0;
		cursor: pointer;
		z-index: 2;
		transition: color 0.3s;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.toggle-opt.active {
		color: #fff;
		font-weight: 800;
	}

	.toggle-slider {
		position: absolute;
		top: 4px;
		left: 4px;
		width: calc(50% - 4px);
		height: calc(100% - 8px);
		background: linear-gradient(135deg, #22c55e, #16a34a);
		border-radius: 10px;
		transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		z-index: 1;
		box-shadow: 0 2px 8px rgba(34, 197, 94, 0.4);
	}

	/* Light mode: active text stays white over green */
	:global([data-theme="light"]) .toggle-opt.active {
		color: #fff;
	}

	.luxury-toggle.total-active .toggle-slider {
		transform: translateX(100%);
	}

	/* Cards section */
	.cards-scroll {
		display: flex;
		gap: 1rem;
		overflow-x: auto;
		padding-bottom: 1rem;
		scrollbar-width: none;
	}

	.cards-scroll::-webkit-scrollbar {
		display: none;
	}

	/* Transactions */
	.transactions-list {
		padding: 0 1.2rem;
	}

	.transactions-list :global(.insight-item:last-child) {
		border-bottom: none;
	}
</style>

<script>
	const toggle = document.getElementById("expense-toggle");
	const personalSummary = document.getElementById("summary-personal");
	const totalSummary = document.getElementById("summary-total");
	const opts = toggle?.querySelectorAll(".toggle-opt");

	opts?.forEach((opt) => {
		opt.addEventListener("click", () => {
			const type = opt.getAttribute("data-type");

			// Update classes
			opts.forEach((o) => o.classList.remove("active"));
			opt.classList.add("active");

			if (type === "total") {
				toggle?.classList.add("total-active");
				if (personalSummary) personalSummary.style.display = "none";
				if (totalSummary) totalSummary.style.display = "block";
			} else {
				toggle?.classList.remove("total-active");
				if (personalSummary) personalSummary.style.display = "block";
				if (totalSummary) totalSummary.style.display = "none";
			}
		});
	});
</script>
