---
interface Props {
    amount: number;
    label?: string;
    trend?: string;
}

const { amount, label = "TOTAL WEALTH PORTFOLIO" } = Astro.props;

import { formatAmount } from "../lib/format";

// Month comparison logic
const trend = Astro.props.trend || null;
---

<section class="portfolio-card">
    <span class="portfolio-title">{label}</span>
    <div class="portfolio-amount">
        <span class="currency">$</span>
        <span class="big-gold">{formatAmount(amount)}</span>
    </div>
    {
        trend && (
            <div class="trend-pill">
                <span class="trend-icon">📈</span>
                <span class="trend-val">{trend}</span>
            </div>
        )
    }
</section>

<style>
    .portfolio-card {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 1.2rem 1.5rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        box-shadow: 0 10px 30px var(--glass-shadow);
    }

    .portfolio-title {
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        color: var(--text-muted);
        font-weight: 700;
    }

    .portfolio-amount {
        font-family: "Montserrat", sans-serif;
        font-weight: 800;
    }

    .currency {
        font-size: 1.1rem;
        vertical-align: top;
        margin-right: 2px;
        color: var(--primary);
    }

    .big-gold {
        font-size: 2.4rem;
        color: var(--primary);
        letter-spacing: -1px;
    }

    .cents {
        font-size: 1.5rem;
        color: var(--accent);
        opacity: 0.8;
    }

    .trend-pill {
        background: rgba(46, 204, 113, 0.1);
        color: #2ecc71;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 700;
        width: fit-content;
        align-self: center;
        margin-top: 0.2rem;
    }
</style>
