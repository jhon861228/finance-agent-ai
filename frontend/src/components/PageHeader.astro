---
interface Props {
    username: string;
    title?: string;
    showBack?: boolean;
    backUrl?: string;
}

const {
    username,
    title,
    showBack = false,
    backUrl = "/dashboard",
} = Astro.props;

import ThemeToggle from "./ThemeToggle.astro";
---

<header class="luxury-head">
    <div class="left-section">
        {
            showBack ? (
                <a href={backUrl} class="back-btn-luxury">
                    <span>←</span>
                </a>
            ) : (
                <div class="user-pill">
                    <div class="avatar-sm">{username[0].toUpperCase()}</div>
                    <div class="user-meta">
                        <span class="greet">Good Morning,</span>
                        <span class="name-bold">{username}</span>
                    </div>
                </div>
            )
        }
    </div>

    {
        title && (
            <div class="title-container">
                <span class="sec-label">GROUP ACCOUNT</span>
                <h1 class="gold-text">{title}</h1>
            </div>
        )
    }

    <div class="right-section">
        <ThemeToggle />
        <a href="/logout" class="notif-bell logout-btn" title="Logout">
            <span class="bell-icon">🚪</span>
        </a>
    </div>
</header>

<style>
    .luxury-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
        min-height: 50px;
    }

    .user-meta {
        display: flex;
        flex-direction: column;
    }

    .greet {
        font-size: 0.75rem;
        color: var(--text-muted);
        display: block;
    }

    .name-bold {
        font-weight: 700;
        font-size: 1rem;
        font-family: "Montserrat", sans-serif;
    }

    .title-container {
        text-align: center;
    }

    .sec-label {
        font-size: 0.6rem;
        letter-spacing: 0.15em;
        color: var(--text-muted);
        font-weight: 700;
        display: block;
        margin-bottom: 2px;
    }

    .luxury-head h1 {
        font-size: 1.2rem;
        margin: 0;
    }

    .right-section {
        display: flex;
        gap: 0.8rem;
        align-items: center;
    }

    .notif-bell {
        width: 40px;
        height: 40px;
        background: var(--card-bg);
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 1px solid var(--glass-border);
        box-shadow: 0 4px 10px var(--glass-shadow);
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .notif-bell:hover {
        background: var(--primary-glow);
        border-color: var(--primary);
    }

    .bell-icon {
        font-size: 1rem;
    }
</style>
