---
interface Props {
    userId: string;
    token: string;
}

const { userId, token } = Astro.props;
---

<div id="quick-add-overlay" class="modal-overlay">
    <div id="quick-add-sheet" class="modal-panel">
        <div class="sheet-handle"></div>
        <div class="sheet-header">
            <h2>NUEVO GASTO</h2>
            <button id="close-quick-add" class="close-btn" type="button"
                >×</button
            >
        </div>

        <form id="quick-add-form" class="sheet-form">
            <div class="qa-input-group">
                <label for="qa-amount">CUÁNTO</label>
                <input
                    type="number"
                    id="qa-amount"
                    name="amount"
                    step="0.01"
                    placeholder="0.00"
                    required
                />
            </div>

            <div class="qa-input-group">
                <label for="qa-desc">QUÉ</label>
                <input
                    type="text"
                    id="qa-desc"
                    name="description"
                    placeholder="Ej. Starbucks, Alquiler..."
                    required
                />
            </div>

            <div class="qa-input-group">
                <label for="qa-cat">CATEGORÍA (OPCIONAL)</label>
                <input
                    type="text"
                    id="qa-cat"
                    name="category"
                    placeholder="Dejar vacío para auto-clasificar"
                />
            </div>

            <button type="submit" id="qa-submit" class="qa-submit-btn">
                GUARDAR GASTO
            </button>
        </form>
    </div>
</div>

<style>
    /* ── Overlay ── */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 1000;
        /* visibility trick: lets CSS transitions work properly */
        visibility: hidden;
        opacity: 0;
        transition:
            opacity 0.3s ease,
            visibility 0s linear 0.3s;

        /* Mobile: align panel to bottom */
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    .modal-overlay.active {
        visibility: visible;
        opacity: 1;
        transition:
            opacity 0.3s ease,
            visibility 0s linear 0s;
    }

    /* ── Panel (bottom-sheet on mobile) ── */
    .modal-panel {
        width: 100%;
        max-width: 100%;
        background: var(--bg);
        border-top: 1px solid var(--glass-border);
        border-radius: 28px 28px 0 0;
        padding: 1rem 1.5rem 2.5rem;
        transform: translateY(110%);
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 -12px 48px rgba(0, 0, 0, 0.5);
    }

    .modal-overlay.active .modal-panel {
        transform: translateY(0);
    }

    /* ── Tablet / Desktop: centered dialog ── */
    @media (min-width: 640px) {
        .modal-overlay {
            align-items: center;
        }

        .modal-panel {
            width: 460px;
            max-width: 90vw;
            border-radius: 28px;
            border: 1px solid var(--glass-border);
            padding: 2rem;
            transform: translateY(20px) scale(0.97);
            opacity: 0;
            transition:
                transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.35s ease;
        }

        .modal-overlay.active .modal-panel {
            transform: translateY(0) scale(1);
            opacity: 1;
        }

        /* Hide the drag handle on desktop */
        .sheet-handle {
            display: none;
        }
    }

    /* ── Handle ── */
    .sheet-handle {
        width: 40px;
        height: 4px;
        background: var(--glass-border);
        border-radius: 2px;
        margin: 0 auto 1.2rem;
    }

    /* ── Header ── */
    .sheet-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .sheet-header h2 {
        font-family: "Montserrat", sans-serif;
        font-size: 1.1rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        margin: 0;
        color: var(--text);
    }

    .close-btn {
        background: var(--secondary, rgba(255, 255, 255, 0.08));
        border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.1));
        width: 34px;
        height: 34px;
        border-radius: 50%;
        color: var(--text);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.3rem;
        line-height: 1;
        cursor: pointer;
        transition:
            background 0.2s,
            transform 0.2s;
    }

    .close-btn:hover {
        background: rgba(255, 255, 255, 0.15);
        transform: scale(1.1);
    }

    /* ── Form ── */
    .sheet-form {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .qa-input-group {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .qa-input-group label {
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        color: var(--text-muted);
        text-transform: uppercase;
    }

    .qa-input-group input {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.1));
        border-radius: 12px;
        padding: 12px 16px;
        color: var(--text);
        font-size: 0.95rem;
        font-family: inherit;
        width: 100%;
        box-sizing: border-box;
        transition:
            border-color 0.2s,
            box-shadow 0.2s;
    }

    .qa-input-group input:focus {
        outline: none;
        border-color: #22c55e;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15);
    }

    #qa-amount {
        font-size: 1.8rem;
        text-align: center;
        font-weight: 800;
        color: var(--primary);
        font-family: "Montserrat", sans-serif;
        letter-spacing: -1px;
    }

    /* ── Submit button ── */
    .qa-submit-btn {
        width: 100%;
        padding: 14px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff;
        font-family: "Montserrat", sans-serif;
        font-size: 0.85rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        cursor: pointer;
        transition:
            opacity 0.2s,
            transform 0.15s,
            box-shadow 0.2s;
        box-shadow: 0 4px 16px rgba(34, 197, 94, 0.35);
        margin-top: 0.3rem;
    }

    .qa-submit-btn:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(34, 197, 94, 0.45);
    }

    .qa-submit-btn:active {
        transform: translateY(0);
    }

    .qa-submit-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    /* ── Light mode tweaks ── */
    :global([data-theme="light"]) .modal-panel {
        background: #fff;
    }

    :global([data-theme="light"]) .qa-input-group input {
        background: #f8fafc;
        border-color: #e2e8f0;
        color: #1a1a1a;
    }

    :global([data-theme="light"]) .close-btn {
        background: #f1f5f9;
        border-color: #e2e8f0;
        color: #1a1a1a;
    }
</style>

<script is:inline define:vars={{ userId, token }}>
document.addEventListener("DOMContentLoaded", () => {
    const overlay = document.getElementById("quick-add-overlay");
    const form = document.getElementById("quick-add-form");
    const closeBtn = document.getElementById("close-quick-add");
    let trigger = document.getElementById("nav-add-trigger");

    function openModal() {
        if (!overlay) return;
        overlay.classList.add("active");
        document.body.style.overflow = "hidden";
    }

    function closeModal() {
        if (!overlay) return;
        overlay.classList.remove("active");
        document.body.style.overflow = "";
    }

    // Fallback: buscar el trigger por clase si no existe por id
    if (!trigger) {
        trigger = document.querySelector(".nav-add-trigger");
    }

    if (trigger) trigger.addEventListener("click", openModal);
    if (closeBtn) closeBtn.addEventListener("click", closeModal);
    if (overlay) overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closeModal();
    });

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeModal();
    });

    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const btn = document.getElementById("qa-submit");
            btn.disabled = true;
            btn.innerText = "GUARDANDO...";

            const formData = new FormData(form);
            const data = {
                amount: parseFloat(formData.get("amount")),
                description: formData.get("description"),
                category: formData.get("category"),
                userId: userId,
                timestamp: Date.now(),
            };

            try {
                const headers = {
                    "Content-Type": "application/json",
                    "X-API-Key": "development-key",
                };

                // Attach Authorization header when token is provided
                if (token) headers['Authorization'] = `Bearer ${token}`;

                // If the app set a client-side cookie with the user's email (optional), forward it
                const cookies = document.cookie.split(';').map(c => c.trim());
                const emailCookie = cookies.find(c => c.startsWith('userEmail=') || c.startsWith('email='));
                if (emailCookie) {
                    const emailValue = emailCookie.split('=')[1];
                    if (emailValue) headers['X-User-Email'] = decodeURIComponent(emailValue);
                }

                const response = await fetch(
                    `${window.location.origin}/api/personal/expenses/${userId}`,
                    {
                        method: "POST",
                        headers,
                        body: JSON.stringify(data),
                    },
                );

                if (response.ok) {
                    window.location.reload();
                } else if (response.status === 403) {
                    const body = await response.json().catch(() => ({}));
                    const message = body?.error || 'Acceso restringido: tu correo no está autorizado para usar este sitio.';
                    alert(message);
                    btn.disabled = false;
                    btn.innerText = "GUARDAR GASTO";
                } else {
                    alert("Error al guardar el gasto");
                    btn.disabled = false;
                    btn.innerText = "GUARDAR GASTO";
                }
            } catch (err) {
                console.error(err);
                alert("Error de conexión");
                btn.disabled = false;
                btn.innerText = "GUARDAR GASTO";
            }
        });
    }
});
</script>
